# ===================================================
# AMANAH DSN-MUI - WEB PUBLIC ENVIRONMENT TEMPLATE
# ===================================================
# Salin file ini menjadi .env atau .env.local untuk environment lokal,
# atau atur variabel di bawah ini pada server production / CI-CD.

# ── API Backend Endpoint ──
# Development: http://localhost:4002/api/public
# Production : https://amanah.dsnmui.or.id/api/public
VITE_API_URL=http://localhost:4002/api/public

# ── Server / Assets Host ──
# Development: http://localhost:4002
# Production : https://amanah.dsnmui.or.id
VITE_SERVER_URL=http://localhost:4002

# ── Application Metadata ──
VITE_APP_NAME="Amanah DSN-MUI Public Portal"
VITE_APP_ENV=development
